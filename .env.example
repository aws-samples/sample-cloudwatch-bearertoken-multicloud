# CloudWatch OTLP Endpoints — separate tokens for metrics and logs
CW_METRICS_BEARER_TOKEN=your-metrics-bearer-token-here
CW_LOGS_BEARER_TOKEN=your-logs-bearer-token-here
CW_REGION=us-east-1

# Product API (Lambda)
CW_LOG_GROUP=/multicloud/ecommerce/product-api
CW_LOG_STREAM=lambda
INVENTORY_SERVICE_URL=https://your-azure-function.azurewebsites.net
PRICING_SERVICE_URL=https://your-region-your-project.cloudfunctions.net/pricing_lookup
CROSS_CLOUD_API_KEY=your-shared-api-key
DEPLOYMENT_ENV=production

# Inventory Service (Azure Functions)
# CW_LOG_GROUP=/multicloud/ecommerce/inventory-service
# CW_LOG_STREAM=azure-functions

# Pricing Service (GCP Cloud Functions)
# CW_LOG_GROUP=/multicloud/ecommerce/pricing-service
# CW_LOG_STREAM=gcp-cloud-functions
